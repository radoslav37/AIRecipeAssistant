@model List<AIRecipeAssistant.Models.SearchHistory>

@{
    ViewData["Title"] = "История";
}

<h1>История на търсенията</h1>

@if (Model.Count == 0)
{
    <p>Все още няма запазени търсения.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Продукти</th>
                <th>Намерени рецепти</th>
                <th>Дата</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Ingredients</td>
                    <td>@item.RecipeNames</td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}