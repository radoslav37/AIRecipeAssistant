@model List<AIRecipeAssistant.Models.SearchHistory>

@{
    ViewData["Title"] = "История";
}

<h1>История на търсенията</h1>

@if (Model.Count == 0)
{
    <p>Все още няма запазени търсения.</p>
}
else
{
    @foreach (var item in Model.OrderByDescending(x => x.CreatedAt))
    {
        <section class="mb-5">
            <h2 class="h4">Продукти: @item.Ingredients</h2>

            @if (!string.IsNullOrWhiteSpace(item.AiRecipeIdea))
            {
                <div class="alert alert-info">
                    <strong>Идея от ИИ:</strong>
                    <p class="mb-0">@item.AiRecipeIdea</p>
                </div>
            }
            <p class="text-muted">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>

            @if (item.Recipes.Count == 0)
            {
                <p>Няма запазени подробности за рецептите в този стар запис.</p>
            }
            else
            {
                <div class="row">
                    @foreach (var recipe in item.Recipes)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                <img src="@recipe.Image"
                                     class="card-img-top"
                                     alt="@recipe.Title" />
                                <div class="card-body">
                                    <h3 class="h5 card-title">@recipe.Title</h3>
                                    @if (recipe.UsedIngredients.Count > 0)
                                    {
                                        <p>
                                            <strong>Налични:</strong>
                                            @string.Join(", ", recipe.UsedIngredients.Select(x => x.Name))
                                        </p>
                                    }

                                    @if (recipe.MissedIngredients.Count > 0)
                                    {
                                        <p>
                                            <strong>Липсват:</strong>
                                            @string.Join(", ", recipe.MissedIngredients.Select(x => x.Name))
                                        </p>
                                        
                                    }
                                    else
                                    {
                                        <p class="text-success">
                                            <strong>Имаш всички нужни съставки!</strong>
                                        </p>
                                    }
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
}