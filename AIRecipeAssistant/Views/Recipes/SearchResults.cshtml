@model List<AIRecipeAssistant.Models.Meal>

@{
    ViewData["Title"] = "Резултати";
}

<div class="container recipe-page">
    <section class="recipe-page-heading">
        <p class="recipe-section-label mb-2">Подбрано за твоите продукти</p>
        <h1 class="display-6">Рецепти с @ViewBag.Ingredients</h1>
        <a asp-controller="Recipes" asp-action="Index" class="btn btn-success mt-2">
            Ново търсене
        </a>
    </section>

    @if (!string.IsNullOrWhiteSpace(ViewBag.AiRecipeIdea))
    {
        <section class="ai-recipe-card mb-5">
            <div class="ai-recipe-heading">
                <span class="ai-recipe-icon" aria-hidden="true">✦</span>
                <div>
                    <p class="recipe-section-label mb-1">Малко вдъхновение</p>
                    <h2 class="h3 mb-0">Идея от ИИ</h2>
                </div>
                <span class="ai-recipe-sparkle" aria-hidden="true">✳</span>
            </div>
            <div class="ai-recipe-content">@Html.Raw(System.Text.RegularExpressions.Regex.Replace(
                System.Net.WebUtility.HtmlEncode((string)ViewBag.AiRecipeIdea),
                "(?m)^(Ястие:|Допълнителни продукти:|Необходими продукти:|Време за приготвяне:|Приготвяне:)",
                "<strong>$1</strong>"))</div>
        </section>
    }

    @if (Model.Count == 0)
    {
        <div class="recipe-panel">
            <h2 class="h4">Няма намерени рецепти</h2>
            <p class="mb-0">
                Опитай с други продукти, например chicken, potato или tomato.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var meal in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="recipe-card">
                        <img src="@meal.Image" alt="@meal.Title" />
                        <div class="recipe-card-body">
                            <h2 class="h5">@meal.Title</h2>

                            @if (meal.UsedIngredients.Count > 0)
                            {
                                <p>
                                    <strong>Имаш:</strong>
                                    @string.Join(", ", meal.UsedIngredients.Select(x => x.Name))
                                </p>
                            }

                            @if (meal.MissedIngredients.Count > 0)
                            {
                                <p class="mb-0">
                                    <strong>Липсват:</strong>
                                    @string.Join(", ", meal.MissedIngredients.Select(x => x.Name))
                                </p>
                            }
                            else
                            {
                                <p class="text-success mb-0">
                                    <strong>Имаш всички нужни съставки!</strong>
                                </p>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
