@{
    ViewData["Title"] = "Рецепти";
}

<div class="container recipe-page">
    <section class="recipe-page-heading">
        <p class="recipe-section-label mb-2">Започни с това, което имаш</p>
        <h1 class="display-5">Какво готвим днес?</h1>
        <p class="lead mb-0">
            Въведи продуктите си и разгледай рецепти, които може да приготвиш.
        </p>
    </section>

    <section class="recipe-panel">
        <form asp-controller="Recipes" asp-action="Search" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label for="ingredients" class="form-label fw-semibold">
                Продукти
            </label>

            <input type="text"
                   id="ingredients"
                   name="ingredients"
                   class="form-control form-control-lg"
                   placeholder="например: eggs, cheese, tomato"
                   required />

            <div class="form-text mb-3">
                Разделяй продуктите със запетая. Имената на английски обикновено
                дават по-добри резултати.
            </div>

            <button type="submit" class="btn btn-success btn-lg">
                Намери рецепти
            </button>
        </form>
    </section>
</div>